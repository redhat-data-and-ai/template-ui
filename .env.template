# Server configuration
PORT=5003
ENVIRONMENT=development

# Backend API endpoint (used by both Vite dev server and SSR)
VITE_BACKEND_URL=http://localhost:5002

# Session / cookie
COOKIE_SIGN=your-secret-with-minimum-length-of-32-characters

# Authentication (set AUTH_ENABLED=true to enable OIDC)
AUTH_ENABLED=false
SSO_CLIENT_ID=your-sso-client-id
SSO_CLIENT_SECRET=your-sso-client-secret
SSO_ISSUER_HOST=https://your-sso-provider.com
SSO_CALLBACK_URL=http://localhost:5003/auth/callback/oidc

# Backend agent host (used by server proxy)
AGENT_HOST=http://localhost:5002

# Custom adapter config (optional, JSON string of AdapterConfigSchema)
# Only needed when auto-detection does not match your backend.
# Example:
# VITE_ADAPTER_CONFIG={"name":"my-backend","features":{"planApproval":false,"steering":false,"modelSelection":false},"endpoints":{"start":{"path":"/api/research","method":"POST","bodyMapping":{"message":"{{message}}"}},"cancel":{"path":"/api/cancel","method":"POST"}},"stream":{"mode":"direct","chunkFormat":"passthrough"}}
