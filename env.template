# FEATURE_MEMORY_ENABLED_DEFAULT=true
# AGENT_ENDPOINT=https://custom-agent.example.com
# AGENT_TIMEOUT_MS=30000

# Redis (optional — falls back to in-memory sessions when absent)
# REDIS_HOST=localhost
