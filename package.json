{
  "name": "template-ui",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently \"npm run dev:client\" \"npm run dev:server\"",
    "dev:client": "vite",
    "dev:server": "nodemon --watch src/server --ext ts --exec \"NODE_OPTIONS='--inspect' tsx --env-file=.env src/server/index.ts\"",
    "build": "npm run build:client && npm run build:server",
    "build:client": "tsc -b && vite build",
    "build:server": "tsc --project src/server/tsconfig.json && mkdir -p dist/server/static && cp -R src/server/static/. dist/server/static/",
    "start": "node --env-file=.env --inspect dist/server/index.js",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.2",
    "@fastify/cors": "^11.1.0",
    "@fastify/helmet": "^13.0.2",
    "@fastify/oauth2": "^8.1.2",
    "@fastify/rate-limit": "^10.3.0",
    "@fastify/session": "^11.1.0",
    "@fastify/static": "^10.1.3",
    "@fastify/url-data": "^6.0.3",
    "@langchain/core": "^0.3.55",
    "@langchain/langgraph-sdk": "^1.9.2",
    "@mcp-ui/client": "^7.1.1",
    "@open-policy-agent/opa-wasm": "^1.10.0",
    "@opentelemetry/auto-instrumentations-node": "^0.76.0",
    "@opentelemetry/exporter-metrics-otlp-http": "^0.218.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.218.0",
    "@opentelemetry/resources": "^2.7.1",
    "@opentelemetry/sdk-node": "^0.218.0",
    "@opentelemetry/semantic-conventions": "^1.41.1",
    "@patternfly/chatbot": "^6.5.0",
    "@patternfly/patternfly": "^6.4.0",
    "@patternfly/react-core": "^6.4.3",
    "@patternfly/react-icons": "^6.4.0",
    "@patternfly/react-styles": "^6.4.0",
    "@patternfly/react-table": "^6.4.3",
    "@reduxjs/toolkit": "^2.11.2",
    "@tailwindcss/vite": "^4.1.5",
    "@types/uuid": "^10.0.0",
    "clsx": "^2.1.1",
    "fastify": "^5.5.0",
    "fastify-plugin": "^5.0.1",
    "ioredis": "^5.10.1",
    "js-yaml": "^4.3.1",
    "lucide-react": "^0.508.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^9.0.3",
    "react-redux": "^9.2.0",
    "react-router-dom": "^7.5.3",
    "rehype-highlight": "^7.0.2",
    "rehype-sanitize": "^6.0.0",
    "recharts": "3.10.1",
    "remark-gfm": "^4.0.1",
    "tailwind-merge": "^3.2.0",
    "tailwindcss": "^4.1.5",
    "uuid": "^11.1.0"
  },
  "overrides": {
    "@grpc/grpc-js": "^1.14.4",
    "@opentelemetry/propagator-jaeger": ">=2.9.0",
    "js-cookie": ">=3.0.7",
    "langsmith": ">=0.6.0"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@eslint/js": "^9.22.0",
    "@playwright/test": "^1.61.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/jest-axe": "^3.5.9",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.17.2",
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.3",
    "@types/react-redux": "^7.1.34",
    "@vitejs/plugin-react-swc": "^3.9.0",
    "@vitest/coverage-v8": "^4.1.10",
    "concurrently": "^9.2.0",
    "eslint": "^9.22.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.19",
    "globals": "^16.0.0",
    "jest-axe": "^10.0.0",
    "jsdom": "^29.1.1",
    "nodemon": "^3.1.10",
    "pino-pretty": "^13.1.1",
    "tsx": "^4.20.4",
    "tw-animate-css": "^1.2.9",
    "typescript": "~5.7.2",
    "typescript-eslint": "^8.26.1",
    "vite": "^6.3.4",
    "vitest": "^4.1.6"
  }
}
