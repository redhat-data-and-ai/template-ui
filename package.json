{
  "name": "template-ui",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently \"npm run dev:client\" \"npm run dev:server\"",
    "dev:client": "vite",
    "dev:server": "nodemon --watch src/server --ext ts --exec \"NODE_OPTIONS='--inspect' tsx --env-file=.env src/server/index.ts\"",
    "build": "npm run build:client && npm run build:server",
    "build:client": "tsc -b && vite build",
    "build:server": "tsc --project src/server/tsconfig.json && mkdir -p dist/server/static && cp -R src/server/static/. dist/server/static/",
    "start": "node --env-file=.env --inspect dist/server/index.js",
    "lint": "eslint .",
    "render:deployment": "tsx scripts/render-deployment.ts",
    "render:deployment:check": "tsx scripts/render-deployment.ts --check",
    "preview": "vite preview",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "i18n:report": "node scripts/i18n-report.mjs"
  },
  "dependencies": {
    "@fastify/cookie": "11.1.3",
    "@fastify/cors": "11.3.1",
    "@fastify/helmet": "13.1.2",
    "@fastify/oauth2": "8.3.1",
    "@fastify/rate-limit": "11.2.1",
    "@fastify/session": "11.1.4",
    "@fastify/static": "10.1.6",
    "@fastify/url-data": "6.0.5",
    "@langchain/core": "1.2.17",
    "@langchain/langgraph-sdk": "1.12.3",
    "@mcp-ui/client": "7.1.1",
    "@open-policy-agent/opa-wasm": "1.10.0",
    "@opentelemetry/auto-instrumentations-node": "0.76.0",
    "@opentelemetry/exporter-metrics-otlp-http": "0.218.0",
    "@opentelemetry/exporter-trace-otlp-http": "0.218.0",
    "@opentelemetry/resources": "2.12.0",
    "@opentelemetry/sdk-node": "0.218.0",
    "@opentelemetry/semantic-conventions": "1.43.0",
    "@patternfly/chatbot": "6.7.1",
    "@patternfly/patternfly": "6.6.1",
    "@patternfly/react-core": "6.6.1",
    "@patternfly/react-icons": "6.6.1",
    "@patternfly/react-styles": "6.6.1",
    "@patternfly/react-table": "6.6.1",
