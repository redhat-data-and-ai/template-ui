PORT=8080
ENVIRONMENT=development

COOKIE_SIGN=your-secret-with-minimum-length-of-32-characters
AUTH_ENABLED=true
SSO_ISSUER_HOST=https://auth.example.com/auth/realms/YourRealm
SSO_CLIENT_ID=your-client-id
SSO_CLIENT_SECRET=your-client-secret
SSO_CALLBACK_URL=http://localhost:8080/auth/callback/oidc

AGENT_HOST=http://localhost:5002
EVAL_HOST=http://127.0.0.1:8099

CORS_ORIGIN=http://localhost:8080

# Redis (optional — falls back to in-memory sessions when absent)
# REDIS_HOST=localhost
# REDIS_PORT=6379
# REDIS_PASSWORD=
# REDIS_TLS=false

# Group-based access (requires AUTH_ENABLED=true).
# Comma-separated Keycloak realm_access.roles (whitespace around commas is ignored).
# Both empty: everyone has full developer access.
# Only one group set: that group is an allow-list (others denied).
# Both set: developers get eval + developer page; users get chat only.
# No effect when AUTH_ENABLED=false (dev bypass grants full developer access).
# DEVELOPER_GROUP=lightspeed-developer,admin
# USER_GROUP=lightspeed-user,guest
